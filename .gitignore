# ── Build artifacts / binaries ──────────────────────────────
dist/
build/
installer/*.exe
# generated by tools/build_release.py from services/version.py
installer/version.iss
*.spec.bak

# ── Databases & data (never commit real data) ───────────────
*.db
*.db-shm
*.db-wal
db_backups/
data/monthly_history*.json
# the month data sets: copies of the customer's SCADA exports, the generated
# report versions and their manifests (see month_dataset_service)
report_data/
backend/uploads/
field_images/

# ── Secrets / local config ──────────────────────────────────
.env
sync_config.json

# Runtime logs + local dev artifacts (uvicorn log, dev uploads dir)
backend/*.log
backend/uploads_dev/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# ── Android build ───────────────────────────────────────────
android/.gradle/
android/build/
android/app/build/
android/local.properties

# ── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*

# ── stray test artifacts ────────────────────────────────────
*_smoke.png
.heatmap_smoke.png

